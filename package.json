{
  "name": "ts-profanity-filter",
  "version": "1.4.0",
  "description": "TypeScript profanity filter that returns text segments for UI rendering. English and German built in, any language registrable, false positives like Klassik and classic cleared, leetspeak and lookalikes matched — plus an optional AI check for hate, threats and harassment, and DSA Art. 17 statements of reasons for what you do about them.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./lang/en": {
      "types": "./dist/lang/en.d.ts",
      "default": "./dist/lang/en.js"
    },
    "./lang/de": {
      "types": "./dist/lang/de.d.ts",
      "default": "./dist/lang/de.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./compliance": {
      "types": "./dist/compliance/index.d.ts",
      "default": "./dist/compliance/index.js"
    },
    "./pii": {
      "types": "./dist/pii/index.d.ts",
      "default": "./dist/pii/index.js"
    },
    "./batch": {
      "types": "./dist/batch/index.d.ts",
      "default": "./dist/batch/index.js"
    },
    "./batch/node": {
      "types": "./dist/batch/node.d.ts",
      "default": "./dist/batch/node.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "angular": [
        "./dist/angular.d.ts"
      ],
      "lang/en": [
        "./dist/lang/en.d.ts"
      ],
      "lang/de": [
        "./dist/lang/de.d.ts"
      ],
      "ai": [
        "./dist/ai/index.d.ts"
      ],
      "compliance": [
        "./dist/compliance/index.d.ts"
      ],
      "pii": [
        "./dist/pii/index.d.ts"
      ],
      "batch": [
        "./dist/batch/index.d.ts"
      ],
      "batch/node": [
        "./dist/batch/node.d.ts"
      ]
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "demo": "npm run build && node scripts/build-demo.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && node --test test/*.test.ts",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test"
  },
  "keywords": [
    "profanity",
    "filter",
    "typescript",
    "censor",
    "moderation",
    "german",
    "deutsch",
    "schimpfwoerter",
    "react",
    "vue",
    "angular",
    "i18n",
    "multilingual",
    "ai",
    "llm",
    "claude",
    "content-moderation",
    "hate-speech",
    "gemini",
    "ollama",
    "dsa",
    "digital-services-act",
    "compliance",
    "batch",
    "streaming",
    "pii",
    "cli"
  ],
  "author": "Kevin Imig <kevinci.coding@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Kevinci/ts-profanity-filter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinci/ts-profanity-filter.git"
  },
  "bugs": {
    "url": "https://github.com/Kevinci/ts-profanity-filter/issues"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.60",
    "react": ">=16.8",
    "vue": ">=3.3",
    "fast-pdf": ">=0.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "fast-pdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "fast-pdf": "^0.7.1",
    "react": "^19.2.8",
    "typescript": "^5.9.3",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ts-profanity-filter": "./dist/cli.js"
  }
}
