{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["ES2020", "DOM"],

    /* Modules */
    "moduleResolution": "NodeNext",

    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
